#!/bin/bash
# chamomile — restores sleep and removes everything coffee set up:
# launchd tick, repeating RTC wake, disablesleep.
# Idempotent. Exit: 0 ok, 1 error, 2 usage.

set -uo pipefail
PROG="$(basename "$0")"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LD="${LAUNCHD_DIR:-/Library/LaunchDaemons}"   # override per i test
LABEL=local.coffee.tick
PLIST_DST="$LD/$LABEL.plist"
CONFIG="$ROOT/state/config"
diag() { printf '%s: %s\n' "$PROG" "$*" >&2; }

repeating_raw() {
  pmset -g sched | awk '
    /^Repeating power events:/ { f=1; next }
    f && /^[A-Za-z].*:/        { f=0 }
    f && NF                   { print }
  '
}
sleep_disabled() { pmset -g | grep -Eq 'SleepDisabled[[:space:]]+1'; }
job_present() { [ -f "$PLIST_DST" ]; }
to_min() { printf '%s' $(( 10#${1%%:*} * 60 + 10#${1##*:} )); }

# minutes-of-day of the repeating wake, whatever the 12h/24h rendering is
wake_repeat_minutes() {
  repeating_raw | awk '
    /wake/ {
      for (i = 1; i <= NF; i++) if ($i == "at") { t = $(i + 1); break }
      if (t == "") next
      h = 0; m = 0
      if (t ~ /[AaPp][Mm]$/) {
        ap = tolower(substr(t, length(t) - 1, 2))
        sub(/[AaPp][Mm]$/, "", t)
        split(t, a, ":"); h = a[1] + 0; m = a[2] + 0
        if (ap == "pm" && h != 12) h += 12
        if (ap == "am" && h == 12) h = 0
      } else {
        split(t, a, ":"); h = a[1] + 0; m = a[2] + 0
      }
      print h * 60 + m; exit
    }'
}

usage() {
  cat <<'EOF'
Uso: chamomile [--force]

  Consente lo sleep (disablesleep 0) e rimuove i timer di coffee:
  il tick di launchd e il wake ripetuto (l'orario configurato, default 06:30).

  --force  cancella anche eventi ripetuti NON creati da coffee.
           Gli allarmi one-shot com.apple.alarm.* non vengono mai toccati.
EOF
  exit 0
}

FORCE=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --force)   FORCE=1 ;;
    *)         diag "argomento non riconosciuto: $1"; exit 2 ;;
  esac
  shift
done

# 1) FIRST give sleep back: this is the escape hatch, it must not depend on the rest
sudo pmset -a disablesleep 0 || { diag "pmset -a disablesleep 0 è fallito"; exit 1; }

# 2) remove the launchd tick (and the job of any previous installation)
for old in com.roberto.caffeine.tick com.roberto.coffee.tick; do
  [ -f "$LD/$old.plist" ] || continue
  sudo launchctl bootout "system/$old" >/dev/null 2>&1 || true
  sudo rm -f "$LD/$old.plist"
done
if job_present; then
  sudo launchctl bootout "system/$LABEL" >/dev/null 2>&1 || true
  sudo rm -f "$PLIST_DST" || { diag "rimozione del plist fallita: $PLIST_DST"; exit 1; }
fi

# 3) remove the repeating timers (only ours, unless --force)
OUR_WAKE=06:30
if [ -f "$CONFIG" ]; then
  w=$(sed -n 's/^WAKE=//p' "$CONFIG" | head -1)
  [ -n "$w" ] && OUR_WAKE="$w"
fi
foreign=0
if [ -n "$(repeating_raw)" ]; then
  if [ "$FORCE" -eq 0 ] && [ "$(wake_repeat_minutes)" != "$(to_min "$OUR_WAKE")" ]; then
    diag "eventi ripetuti presenti ma non sono quelli di coffee: non li cancello."
    repeating_raw | sed 's/^/  /' >&2
    diag "usa --force per rimuoverli comunque"
    foreign=1
  else
    sudo pmset repeat cancel || { diag "pmset repeat cancel è fallito"; exit 1; }
  fi
fi

# 4) forget the configured times
rm -f "$CONFIG"

# 5) verify the effect, not the exit code
ok=0
if sleep_disabled; then diag "disablesleep risulta ancora attivo"; ok=1; fi
[ "$foreign" -eq 0 ] && job_present && { diag "il tick di launchd è ancora installato"; ok=1; }
[ "$foreign" -eq 0 ] && [ -n "$(repeating_raw)" ] && { diag "restano eventi ripetuti"; repeating_raw | sed 's/^/  /' >&2; ok=1; }

[ "$foreign" -ne 0 ] && exit 1
[ "$ok" -ne 0 ] && exit 1

printf 'chamomile: ok — sleep consentito, tick e timer rimossi\n'
