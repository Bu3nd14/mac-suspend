<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roberto.coffee.tick</string>

  <!-- The two times are passed as arguments, so the tick derives its guard windows
       from them instead of hardcoding them here. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@ROOT@/daemon/coffee-tick</string>
    <string>@SLEEP@</string>
    <string>@WAKE@</string>
  </array>

  <!-- suspend at --sleep; --wake plus @BH@:@BM@ (the backup) restore disablesleep -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>@SH@</integer><key>Minute</key><integer>@SM@</integer></dict>
    <dict><key>Hour</key><integer>@WH@</integer><key>Minute</key><integer>@WM@</integer></dict>
    <dict><key>Hour</key><integer>@BH@</integer><key>Minute</key><integer>@BM@</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>@ROOT@/logs/tick.out</string>
  <key>StandardErrorPath</key>
  <string>@ROOT@/logs/tick.err</string>
</dict>
</plist>
