<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roberto.coffee.tick</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@ROOT@/daemon/coffee-tick</string>
  </array>

  <!-- 23:30 releases sleep and sleeps; 06:30 and 06:45 restore it.
       06:45 is the second chance if the 06:30 job did not run. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>@ROOT@/logs/tick.out</string>
  <key>StandardErrorPath</key>
  <string>@ROOT@/logs/tick.err</string>
</dict>
</plist>
