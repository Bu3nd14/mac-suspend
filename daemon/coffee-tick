#!/bin/bash
# coffee-tick — run by launchd at the times in the plist.
# It decides what to do from the current time, inside guard windows:
# a missed calendar job is re-run at the next wake, so without a window
# a tick missed at 23:30 could put the machine to sleep at noon.
#
#   23:25-23:45  → disablesleep 0 + sleepnow   (night: allow sleep, then sleep)
#   06:25-12:00  → disablesleep 1              (morning: wake up and stay awake)
#
# Every run also records power source and charge: at night the machine is often
# on battery, and without that datum the morning after is unreadable.

set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # not $HOME: under sudo it is /var/root
LOG="$ROOT/logs/tick.log"
PMSET="${PMSET_BIN:-/usr/bin/pmset}"   # override per i test
mkdir -p "$ROOT/logs"

# --- power state (pmset -g batt, output is not localised) ---
batt_src=$("$PMSET" -g batt | sed -n "s/^Now drawing from '\(.*\)'\$/\1/p")
batt_pct=$("$PMSET" -g batt | awk '/present: true/ {
  for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+%;?$/) { gsub(/[%;]/, "", $i); print $i; exit } }')
batt_src=${batt_src:-unknown}
batt_pct=${batt_pct:-?}
ds=$("$PMSET" -g | awk '$1=="SleepDisabled"{print $2}'); ds=${ds:-0}

stamp=$(date '+%Y-%m-%dT%H:%M:%S%z')
h=$(date +%H); m=$(date +%M)
now=$((10#$h * 60 + 10#$m))

printf '%s tick %s:%s now=%s disablesleep=%s source=%s charge=%s%%\n' \
  "$stamp" "$h" "$m" "$now" "$ds" "$batt_src" "$batt_pct" >> "$LOG" 2>&1

on_batt=0
[ "$batt_src" = "Battery Power" ] && on_batt=1

if [ "$on_batt" -eq 1 ] && [ "$batt_pct" != "?" ] && [ "$batt_pct" -lt 30 ]; then
  printf '%s WARN batteria al %s%% e non su AC: se la notte e lunga la macchina puo spegnersi\n' \
    "$stamp" "$batt_pct" >> "$LOG" 2>&1
fi

if [ "$now" -ge $((23*60 + 25)) ] && [ "$now" -le $((23*60 + 45)) ]; then
  "$PMSET" -a disablesleep 0 >> "$LOG" 2>&1
  "$PMSET" sleepnow          >> "$LOG" 2>&1
  exit 0
fi

if [ "$now" -ge $((6*60 + 25)) ] && [ "$now" -le $((12*60)) ]; then
  if [ "$on_batt" -eq 1 ]; then
    printf '%s WARN sveglia a batteria (%s%%): ricollega l alimentatore, resta sveglia e consuma\n' \
      "$stamp" "$batt_pct" >> "$LOG" 2>&1
  fi
  "$PMSET" -a disablesleep 1 >> "$LOG" 2>&1
  exit 0
fi

# outside any window: do nothing (late re-run of a missed job, or a test tick)
exit 0
