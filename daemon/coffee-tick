#!/bin/bash
# coffee-tick — run by launchd at the times in the plist.
# Arguments: $1 = suspend time (HH:MM), $2 = resume time (HH:MM).
# It decides what to do from the current time, inside guard windows derived from
# those times: a missed calendar job is re-run at the next wake, so without a window
# a tick missed at the suspend time could put the machine to sleep at noon.
#
#   [sleep-5m .. sleep+15m]  → disablesleep 0 + sleepnow   (allow sleep, then sleep)
#   [wake-5m  .. wake+120m]  → disablesleep 1              (wake up and stay awake)
#
# Every run also records power source and charge: at night the machine is often
# on battery, and without that datum the morning after is unreadable.

set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # not $HOME: under sudo it is /var/root
LOG="$ROOT/logs/tick.log"
PMSET="${PMSET_BIN:-/usr/bin/pmset}"   # override for tests
mkdir -p "$ROOT/logs"

SLEEP_AT="${1:-23:30}"
WAKE_AT="${2:-06:30}"

to_min() { printf '%s' $(( 10#${1%%:*} * 60 + 10#${1##*:} )); }

# in_win NOW START END — handles windows that cross midnight
in_win() {
  local n=$1 s=$2 e=$3
  if [ "$s" -le "$e" ]; then
    [ "$n" -ge "$s" ] && [ "$n" -le "$e" ]
  else
    [ "$n" -ge "$s" ] || [ "$n" -le "$e" ]
  fi
}

# --- power state (pmset -g batt, output is not localised) ---
batt_src=$("$PMSET" -g batt | sed -n "s/^Now drawing from '\(.*\)'\$/\1/p")
batt_pct=$("$PMSET" -g batt | awk '/present: true/ {
  for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+%;?$/) { gsub(/[%;]/, "", $i); print $i; exit } }')
batt_src=${batt_src:-unknown}
batt_pct=${batt_pct:-?}
ds=$("$PMSET" -g | awk '$1=="SleepDisabled"{print $2}'); ds=${ds:-0}

stamp=$(date '+%Y-%m-%dT%H:%M:%S%z')
h=$(date +%H); m=$(date +%M)
now=$((10#$h * 60 + 10#$m))

printf '%s tick %s:%s now=%s disablesleep=%s source=%s charge=%s%% sleep=%s wake=%s\n' \
  "$stamp" "$h" "$m" "$now" "$ds" "$batt_src" "$batt_pct" "$SLEEP_AT" "$WAKE_AT" >> "$LOG" 2>&1

on_batt=0
[ "$batt_src" = "Battery Power" ] && on_batt=1

if [ "$on_batt" -eq 1 ] && [ "$batt_pct" != "?" ] && [ "$batt_pct" -lt 30 ]; then
  printf '%s WARN batteria al %s%% e non su AC: se la notte e lunga la macchina puo spegnersi\n' \
    "$stamp" "$batt_pct" >> "$LOG" 2>&1
fi

sleep_from=$(to_min "$SLEEP_AT")
wake_from=$(to_min "$WAKE_AT")
sleep_win_s=$(( (sleep_from - 5 + 1440) % 1440 ))
sleep_win_e=$(( (sleep_from + 15) % 1440 ))
wake_win_s=$(( (wake_from - 5 + 1440) % 1440 ))
wake_win_e=$(( (wake_from + 120) % 1440 ))

if in_win "$now" "$sleep_win_s" "$sleep_win_e"; then
  "$PMSET" -a disablesleep 0 >> "$LOG" 2>&1
  "$PMSET" sleepnow          >> "$LOG" 2>&1
  exit 0
fi

if in_win "$now" "$wake_win_s" "$wake_win_e"; then
  if [ "$on_batt" -eq 1 ]; then
    printf '%s WARN sveglia a batteria (%s%%): ricollega l alimentatore, resta sveglia e consuma\n' \
      "$stamp" "$batt_pct" >> "$LOG" 2>&1
  fi
  "$PMSET" -a disablesleep 1 >> "$LOG" 2>&1
  exit 0
fi

# outside any window: do nothing (late re-run of a missed job, or a test tick)
exit 0
